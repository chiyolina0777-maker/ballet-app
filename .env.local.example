# ===== Supabase(Settings > API からコピー)=====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# サーバー専用(通知バッチ・管理画面の書き込みで使用。クライアントに出さないこと)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===== 管理者(仕様書§3: 環境変数方式)=====
# Supabase Auth のユーザーUUIDをカンマ区切りで
ADMIN_USER_IDS=

# ===== LINE(フェーズ2の認証・通知実装で使用)=====
# LINE Login チャネル
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Messaging API チャネル(通知Push用)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 公式アカウントの友だち追加リンク(LINE Official Account Manager > 友だち追加ガイドのURL。例: https://lin.ee/xxxx)
LINE_FRIEND_URL=

# ===== セッション =====
# 署名用シークレット。`openssl rand -hex 32` で生成
SESSION_SECRET=

# ===== 通知バッチ =====
# Vercel Cron が /api/cron/notify を呼ぶときの認証。`openssl rand -hex 32` で生成
CRON_SECRET=

# ===== サイト =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
